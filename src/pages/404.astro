---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillLink from '@/shared/ui/PillLink.astro';
---

<BaseLayout title="页面未找到" noindex>
  <div class="container">
    <header class="page-heading">
      <h1>404 页面未找到</h1>
      <p>检查地址，或从首页继续浏览。</p>
      <div class="flex gap-3 flex-wrap mt-8">
        <PillLink href="/" solid>
          返回首页
        </PillLink>
        <PillLink href="/search/">搜索内容</PillLink>
      </div>
    </header>
  </div>
</BaseLayout>
