---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillLink from '@/shared/ui/PillLink.astro';
---

<BaseLayout title="页面未找到" noindex>
  <div class="container">
    <header class="page-heading">
      <p class="mono">404</p>
      <h1>这个页面不在这里。</h1>
      <p>地址可能已变更。可以从首页继续浏览，或搜索想找的内容。</p>
      <div class="flex gap-3 flex-wrap mt-8">
        <PillLink href="/" solid>
          返回首页
        </PillLink>
        <PillLink href="/search/">搜索内容</PillLink>
      </div>
    </header>
  </div>
</BaseLayout>
