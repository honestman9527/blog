---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects, summarizeProject } from '@/features/projects/index';
import { ProjectCard } from '@/features/projects/ui';
const projects = (await getProjects()).map(summarizeProject);
---

<BaseLayout title="项目" description="个人项目与实践，记录问题、实现和结果。">
  <div class="container">
    <header class="page-heading">
      <h1>项目</h1>
    </header>
    <div>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    {projects.length === 0 && <p class="empty-state">还没有公开的项目。</p>}
  </div>
</BaseLayout>
