---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getPosts, summarizePost, paginate } from '@/features/blog/index';
import { PostList, Pagination } from '@/features/blog/ui';
const posts = await getPosts();
---

<BaseLayout title="文章" description="工程实践、写作与日常记录。">
  <div class="container">
    <header class="page-heading">
      <h1>文章</h1>
      <p>记录一个问题是怎样被理解、尝试和解决的。</p>
      <nav class="flex flex-wrap gap-6 mt-6" aria-label="文章浏览">
        <a class="text-link" href="/tags/">
          按标签
        </a>
        <a class="text-link" href="/archive/">
          按时间
        </a>
        <a class="text-link" href="/rss.xml">
          RSS 订阅
        </a>
      </nav>
    </header>
    <PostList posts={paginate(posts, 1, siteConfig.postsPerPage).map(summarizePost)} />
    <Pagination current={1} total={Math.ceil(posts.length / siteConfig.postsPerPage)} />
  </div>
</BaseLayout>
