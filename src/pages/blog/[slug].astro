---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentBody from '@/shared/ui/ContentBody.astro';
import { siteConfig } from '@/config/site';
import { profile } from '@/config/profile';
import { formatDate } from '@/shared/utils/date';
import { getPosts, type Post } from '@/features/blog/index';
import { TableOfContents } from '@/features/blog/ui';
import { getCommentConfig } from '@/features/comments/index';
import { Comments } from '@/features/comments/ui';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { slug: post.data.slug }, props: { post } })); }
interface Props { post: Post; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonicalPath = `/blog/${post.data.slug}/`;
const commentConfig = getCommentConfig(canonicalPath, post.data.comments);
const structuredData = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: `${post.data.publishedAt}T00:00:00+08:00`, dateModified: `${post.data.updatedAt ?? post.data.publishedAt}T00:00:00+08:00`, author: { '@type': 'Person', name: profile.name }, url: new URL(canonicalPath, Astro.site).href };
---
<BaseLayout title={post.data.title} description={post.data.description} canonicalPath={canonicalPath} article={post.data} structuredData={structuredData} noindex={post.data.draft}>
  <div class="container" data-pagefind-body data-pagefind-filter="type:文章"><meta data-pagefind-meta="type[content]" content="文章" /><header class="article-heading"><a class="text-link muted" href="/blog/" data-pagefind-ignore>全部文章</a><h1 data-pagefind-meta="title">{post.data.title}</h1><p>{post.data.description}</p><div class="article-meta" data-pagefind-ignore><time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt, siteConfig.timezone)}</time>{post.data.updatedAt && <span>更新于 {formatDate(post.data.updatedAt, siteConfig.timezone)}</span>}{post.data.demo && <span>示例文章</span>}{post.data.draft && <span>草稿预览</span>}</div><div class="tags mt-5" data-pagefind-ignore>{post.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></header>
    <div class="article-grid"><article><ContentBody><Content /></ContentBody></article><TableOfContents headings={headings} /></div>
    {commentConfig && <Comments config={commentConfig} />}
  </div>
</BaseLayout>
<style>
  .article-heading { padding-block:64px 48px; max-width:840px; }
  h1 { margin:28px 0 24px; font-size:clamp(32px,4.5vw,56px); line-height:1.3; letter-spacing:-.025em; font-weight:400; color:white; overflow-wrap:anywhere; }
  .article-heading > p { font-size:18px; color:#a8abb2; max-width:720px; }
  .article-meta { display:flex; flex-wrap:wrap; gap:12px 24px; margin-top:24px; font-size:13px; color:#7d8187; }
  .article-grid { display:grid; grid-template-columns:minmax(0,720px) minmax(160px,220px); justify-content:space-between; gap:64px; }
  article { min-width:0; }
  @media(max-width:1023px) { .article-grid { display:flex; flex-direction:column; gap:0; } }
  @media(max-width:767px) { .article-heading { padding-block:40px 32px; } }
</style>
