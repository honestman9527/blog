---
import { CodeXml, Menu } from '@lucide/astro';
import { siteConfig } from '@/config/site';
const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/blog/'
    ? ['/blog/', '/tags/', '/archive/'].some((prefix) => path.startsWith(prefix))
    : path.startsWith(href);
---

<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.title}，首页`}>
      <CodeXml size={24} stroke-width={1.5} aria-hidden="true" focusable="false" />
      <span>{siteConfig.title}</span>
    </a>
    <button class="pill menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <Menu size={18} stroke-width={1.5} aria-hidden="true" focusable="false" />
      菜单
    </button>
    <nav id="site-nav" aria-label="主导航">
      {siteConfig.navigation.map((item) => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
<script>
  import '../scripts/navigation';
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #0a0a0af5;
    border-bottom: 1px solid #212327;
  }
  .header-inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    min-height: 44px;
    color: white;
    font-size: 14px;
  }
  .brand :global(svg) {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }
  .brand span {
    overflow-wrap: anywhere;
  }
  nav {
    display: flex;
    flex-shrink: 0;
    gap: 24px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #a8abb2;
    font-size: 14px;
  }
  nav a:hover,
  nav a[aria-current] {
    color: white;
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 767px) {
    .header-inner {
      min-height: 64px;
      flex-wrap: wrap;
      gap: 0 12px;
    }
    .brand {
      flex: 1;
    }
    .menu-toggle {
      display: inline-flex;
      flex-shrink: 0;
    }
    nav {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      padding-bottom: 16px;
    }
    nav a {
      justify-content: center;
    }
    :global(html.js) nav {
      display: none;
    }
    :global(html.js) nav[data-open] {
      display: grid;
    }
  }
</style>
