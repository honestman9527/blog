---
import { siteConfig } from '@/config/site';
const path = Astro.url.pathname;
const active = (href: string) => href === '/blog/'
  ? ['/blog/', '/tags/', '/archive/'].some((prefix) => path.startsWith(prefix))
  : path.startsWith(href);
---
<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.title}，首页`}><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M10 5H5v18h5M18 5h5v18h-5M11 18l6-8" stroke="currentColor" stroke-width="1.5" /></svg><span>{siteConfig.title}</span></a>
    <button class="pill menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">菜单</button>
    <nav id="site-nav" aria-label="主导航">
      {siteConfig.navigation.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
<script>import '../scripts/navigation';</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: #0a0a0af5; border-bottom: 1px solid #212327; }
  .header-inner { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: white; font-size: 14px; }
  nav { display: flex; gap: 32px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; color: #a8abb2; font-size: 14px; }
  nav a:hover, nav a[aria-current] { color: white; }
  .menu-toggle { display: none; }
  @media (max-width: 767px) {
    .header-inner { min-height: 72px; flex-wrap: wrap; gap: 0; }
    .menu-toggle { display: inline-flex; }
    nav { width: 100%; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding-bottom: 16px; }
    nav a { justify-content: center; }
    :global(html.js) nav { display: none; }
    :global(html.js) nav[data-open] { display: grid; }
  }
</style>
