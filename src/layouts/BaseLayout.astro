---
import '@fontsource/inter/latin-400.css';
import '@fontsource/geist-mono/latin-400.css';
import '@/shared/styles/global.css';
import { siteConfig } from '@/config/site';
import Header from './components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  article?: { publishedAt: string; updatedAt?: string };
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  article,
  structuredData,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} / ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/social.svg', Astro.site);
const json = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={siteConfig.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href="/rss.xml"
    />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {article && (
      <meta property="article:published_time" content={`${article.publishedAt}T00:00:00+08:00`} />
    )}
    {article?.updatedAt && (
      <meta property="article:modified_time" content={`${article.updatedAt}T00:00:00+08:00`} />
    )}
    {json && <script type="application/ld+json" set:html={json} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到内容
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="container site-footer" data-pagefind-ignore>
      <p>
        {siteConfig.title}
        <span>作品、文字与持续的实践。</span>
      </p>
      <div>
        <a href="/rss.xml" class="text-link">
          RSS 订阅
        </a>
        <span class="mono">© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
<style>
  main {
    min-height: calc(100svh - 250px);
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    border-top: 1px solid #212327;
    padding-block: 40px;
    margin-top: 64px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 13px;
    color: #7d8187;
  }
  p {
    margin: 0;
    color: #dadbdf;
  }
  p span {
    display: block;
    color: #7d8187;
    margin-top: 8px;
  }
  .site-footer > div {
    display: flex;
    align-items: flex-start;
    gap: 32px;
  }
  @media (max-width: 767px) {
    .site-footer {
      flex-direction: column;
      margin-top: 40px;
    }
  }
</style>
