---
import '@fontsource/inter/latin-400.css';
import '@fontsource/geist-mono/latin-400.css';
import '@/shared/styles/global.css';
import { Rss } from '@lucide/astro';
import { siteConfig } from '@/config/site';
import Header from './components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  article?: { publishedAt: string; updatedAt?: string };
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  article,
  structuredData,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} / ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/social.svg', Astro.site);
const json = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={siteConfig.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {siteConfig.favicon && <link rel="icon" href={siteConfig.favicon} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.title} RSS`}
      href="/rss.xml"
    />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {article && (
      <meta property="article:published_time" content={`${article.publishedAt}T00:00:00+08:00`} />
    )}
    {article?.updatedAt && (
      <meta property="article:modified_time" content={`${article.updatedAt}T00:00:00+08:00`} />
    )}
    {json && <script type="application/ld+json" set:html={json} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到内容
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="container site-footer" data-pagefind-ignore>
      <a href="/rss.xml" class="text-link">
        <Rss size={16} stroke-width={1.5} aria-hidden="true" focusable="false" />
        RSS 订阅
      </a>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  main {
    flex: 1;
    min-width: 0;
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    border-top: 1px solid var(--color-hairline);
    padding-block: 24px;
    margin-top: 48px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    font-size: 14px;
    color: var(--color-muted);
  }
  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
</style>
