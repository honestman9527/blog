---
import { Search } from '@lucide/astro';
const development = import.meta.env.DEV;
---

<section class="search" aria-label="站内搜索" data-search>
  <form role="search" action="/search/" method="get">
    <label for="search-input" class="sr-only">
      搜索项目与文章
    </label>
    <div class="search-field">
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="搜索关键词"
        autocomplete="off"
        maxlength="200"
        aria-describedby="search-status"
        disabled={development}
      />
      <button class="pill" type="submit" disabled={development}>
        <Search size={18} stroke-width={1.5} aria-hidden="true" focusable="false" />
        搜索
      </button>
    </div>
  </form>
  <p id="search-status" class="muted" role="status" aria-live="polite">
    {development ? '搜索索引在构建后生成。请运行 pnpm build，再通过 pnpm preview 使用搜索。' : ''}
  </p>
  <button class="pill" type="button" data-search-retry hidden>
    重试搜索
  </button>
  <ol class="search-results" data-search-results></ol>
  <button class="pill" type="button" data-search-more hidden>
    更多结果
  </button>
  <noscript>
    <p>
      请启用 JavaScript 使用搜索，也可以
      <a class="text-link" href="/tags/">
        按标签浏览文章
      </a>
      。
    </p>
  </noscript>
</section>
<script>
  import '../scripts/search';
</script>
<style>
  .search {
    max-width: 720px;
  }
  .search-field {
    display: flex;
    gap: 12px;
  }
  input {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 10px 16px;
    border: 1px solid #363a3f;
    background: #191919;
    color: white;
    border-radius: 8px;
  }
  input::placeholder {
    color: #7d8187;
    font-size: 14px;
  }
  .search-field button {
    padding-inline: 24px;
    flex-shrink: 0;
  }
  #search-status {
    font-size: 14px;
    margin-block: 16px;
  }
  #search-status:empty {
    margin: 0;
  }
  .search-results {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  :global(.search-results li) {
    padding: 24px 0;
    border-bottom: 1px solid #212327;
  }
  :global(.search-results h2) {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
    color: white;
    margin: 8px 0 12px;
  }
  :global(.search-results a:hover) {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  :global(.search-results h2 a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
  :global(.search-results p) {
    margin: 0;
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.8;
  }
  :global(.search-result-type) {
    font-size: 14px;
    color: #7d8187;
  }
  :global(.search-results mark) {
    background: #dadbdf;
    color: #0a0a0a;
    padding: 1px 2px;
    border-radius: 2px;
  }
  @media (max-width: 767px) {
    .search-field {
      flex-wrap: wrap;
    }
    .search-field button {
      min-height: 44px;
    }
  }
</style>
