---
import type { ProjectSummary } from '../data/projects';
interface Props { project: ProjectSummary; prominent?: boolean; }
const { project, prominent = false } = Astro.props;
---
<article class:list={['project-card', { prominent }]}>
  <a href={project.url} class="project-link">
    <div class="project-mark" aria-hidden="true"><span>{project.slug.includes('reading') ? '{ }' : '[ / ]'}</span><div class="mark-lines"><i></i><i></i><i></i></div></div>
    <div class="project-copy"><div class="project-meta"><span>{project.demo ? '示例项目' : '项目'}</span><span>查看详情 ↗</span></div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.stack.map((item) => <span class="tag">{item}</span>)}</div></div>
  </a>
</article>
<style>
  .project-card { border: 1px solid #212327; border-radius: 8px; background: #191919; min-width: 0; }
  .project-link { display: flex; height: 100%; flex-direction: column; }
  .project-mark { height: 200px; display: flex; align-items: center; justify-content: space-between; padding: 32px; border-bottom: 1px solid #212327; background: #0f0f0f; overflow: hidden; }
  .project-mark > span { font-family: var(--font-mono); font-size: 56px; color: #dadbdf; letter-spacing: -.08em; }
  .mark-lines { width: 32%; display: grid; gap: 12px; }
  i { height: 1px; width: 100%; background: #363a3f; }
  i:nth-child(2) { width: 70%; }
  i:nth-child(3) { width: 85%; }
  .project-copy { padding: 28px; }
  .project-meta { display: flex; justify-content: space-between; gap: 16px; font-size: 12px; color: #7d8187; }
  h3 { font-size: 26px; line-height: 1.4; font-weight: 400; color: white; margin: 16px 0 12px; }
  p { margin: 0 0 24px; font-size: 15px; color: #a8abb2; }
  .project-card:has(a:hover) { border-color: #ffffff50; }
  .prominent .project-mark { height: 240px; }
  @media (max-width: 767px) { .project-mark, .prominent .project-mark { height: 160px; padding: 24px; } .project-copy { padding: 24px; } h3 { font-size: 23px; } }
</style>
