---
import { siteConfig } from '@/config/site';
import { formatDate } from '@/shared/utils/date';
import type { PostSummary } from '../data/posts';
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => (
    <article class="entry">
      <h2 class="entry-title">
        <a href={post.url}>{post.title}</a>
      </h2>
      <p class="entry-summary">{post.description}</p>
      <div class="entry-meta">
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt, siteConfig.timezone)}</time>
        {post.draft && <span>草稿预览</span>}
        {post.demo && <span>示例文章</span>}
      </div>
    </article>
  ))}
  {posts.length === 0 && <p class="empty-state">还没有公开的文章。</p>}
</div>
