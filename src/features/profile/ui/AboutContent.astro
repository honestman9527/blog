---
import { profile } from '@/config/profile';
const introduction = profile.placeholder ? '' : profile.introduction.trim();
const socials = profile.socials.filter((social) => social.href.trim());
---

<div class="about-content">
  {(introduction || profile.location || profile.availableFor || socials.length > 0) && (
    <section>
      {introduction && <p>{introduction}</p>}
      {profile.location && <p>{profile.location}</p>}
      {profile.availableFor && <p>{profile.availableFor}</p>}
      {socials.length > 0 && (
        <div class="socials">
          {socials.map((social) => (
            <a class="text-link" href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label}
              <span class="sr-only">（新窗口打开）</span>
            </a>
          ))}
        </div>
      )}
    </section>
  )}
  {profile.skills.length > 0 && (
    <section>
      <h2>关注方向</h2>
      <ul class="skills">
        {profile.skills.map((skill) => (
          <li>{skill}</li>
        ))}
      </ul>
    </section>
  )}
  {profile.experience.length > 0 && (
    <section>
      <h2>经历</h2>
      <ol class="experience">
        {profile.experience.map((entry) => (
          <li>
            <h3>{entry.title}</h3>
            <p>{entry.organization}</p>
            <p class="period muted">{entry.period}</p>
            {entry.description && <p>{entry.description}</p>}
          </li>
        ))}
      </ol>
    </section>
  )}
</div>
<style>
  .about-content {
    max-width: 720px;
  }
  section + section {
    margin-top: 32px;
  }
  h2 {
    margin: 0 0 16px;
    color: var(--color-ink);
    font-size: 22px;
    font-weight: 400;
  }
  p {
    margin: 0;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  p + p {
    margin-top: 12px;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .experience li {
    padding-block: 20px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .experience li:first-child {
    padding-top: 0;
  }
  h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-size: 20px;
    font-weight: 400;
  }
  .period {
    font-size: 14px;
  }
</style>
