---
import { profile } from '@/config/profile';
import SocialLinks from './SocialLinks.astro';
import Avatar from './Avatar.astro';
---

<section class="profile-intro" aria-labelledby="greeting">
  <Avatar />
  <h1 id="greeting" data-greeting>
    你好，欢迎来坐坐。
  </h1>
  <SocialLinks links={profile.socials} />
</section>
<script>
  import '../scripts/greeting';
</script>
<style>
  .profile-intro {
    max-width: 720px;
    padding-block: 64px;
  }
  h1 {
    margin: 0;
    color: var(--color-ink);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  @media (max-width: 767px) {
    .profile-intro {
      padding-block: 40px;
    }
    h1 {
      font-size: 20px;
    }
  }
</style>
