---
import { profile } from '@/config/profile';
const introduction = profile.placeholder ? '' : profile.introduction.trim();
const socials = profile.socials.filter((social) => social.href.trim());
---

<section class="profile-intro" aria-labelledby="author-name">
  <h1 class="page-title" id="author-name">
    {profile.name}
  </h1>
  {profile.role.trim() && <p class="role">{profile.role}</p>}
  {introduction && <p class="introduction">{introduction}</p>}
  {socials.length > 0 && (
    <div class="socials">
      {socials.map((social) => (
        <a class="text-link" href={social.href} target="_blank" rel="noopener noreferrer">
          {social.label}
          <span class="sr-only">（新窗口打开）</span>
        </a>
      ))}
    </div>
  )}
</section>
<style>
  .profile-intro {
    max-width: 720px;
    padding-block: 64px;
  }
  .role {
    margin: 12px 0 0;
    color: var(--color-muted);
  }
  .introduction {
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 767px) {
    .profile-intro {
      padding-block: 40px;
    }
    .introduction {
      font-size: 17px;
    }
  }
</style>
