---
import { profile } from '@/config/profile';
---

{profile.avatar && (
  <img src={profile.avatar} alt={`${profile.name}的头像`} width="80" height="80" />
)}

<style>
  img {
    display: block;
    width: 80px;
    height: 80px;
    margin-bottom: 24px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
